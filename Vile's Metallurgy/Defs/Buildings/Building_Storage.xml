	<AdaptiveStorage.GraphicsDef>
		<defName>Building_ClayPotAshASF</defName>
		<targetDef>Building_ClayPotAsh</targetDef>
		<graphics>
			<li><graphicData><texPath>Things/Pottery/Pot_Ash</texPath><graphicClass>Graphic_Single</graphicClass><drawRotated>false</drawRotated></graphicData></li>
