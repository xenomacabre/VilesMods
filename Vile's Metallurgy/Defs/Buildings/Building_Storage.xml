				<graphicData><texPath>Things/Pottery/Pot_Ash_full</texPath><graphicClass>Graphic_Single</graphicClass><drawRotated>false</drawRotated></graphicData>
				<minimumStackCount>5</minimumStackCount>
				<showContainedItems>false</showContainedItems>
			</li>
		</graphics>
		<showContainedItems>true</showContainedItems>
		<itemGraphics>
			<columns><c0><rows><r0>
				<stackBehaviour>Circle</stackBehaviour>
				<stackOffset>(0,0,0.5)</stackOffset>
				<drawOffset>(0,0,0.05)</drawOffset>
