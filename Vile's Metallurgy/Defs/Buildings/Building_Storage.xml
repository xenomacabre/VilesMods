	<!-- CLAY POTS -->
	
	<ThingDef Name="Building_ClayPot" ParentName="AdaptiveStorageMinifiableBase" Abstract="true">
		<defName>Building_ClayPot</defName>
		<graphicData>
			<texPath>Things/Pottery/Pot_unglazed</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawRotated>false</drawRotated>
			<shadowData>
				<volume>(0.7, 0.3, 0.7)</volume>
			</shadowData>
		</graphicData>
		<size>(1,1)</size>
		<pathCost>40</pathCost>
		<statBases>
			<MarketValue>100</MarketValue>
			<MaxHitPoints>85</MaxHitPoints>
			<WorkToBuild>100</WorkToBuild>
			<Beauty>2</Beauty>
			<Bulk>4</Bulk>
			<Mass>2</Mass>
		</statBases>
		<building>
			<maxItemsInCell>5</maxItemsInCell>
			<preventDeteriorationOnTop>true</preventDeteriorationOnTop>
			<ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
			<fixedStorageSettings>
				<filter>
					<categories>
						<li>Foods</li>
					</categories>
				</filter>
			</fixedStorageSettings>
		</building>
		<tickerType>Rare</tickerType>
		<comps>
			<li Class="SK.CompProperties_RotModified">
				<rotmodifier>0.55</rotmodifier>
			</li>
		</comps>
		<constructionSkillPrerequisite>1</constructionSkillPrerequisite>
		
	</ThingDef>
	
