	<!--
		The updated Core_SK file inherits lifeStageAges from FishThingBase.
		Replace the list explicitly instead of appending another three entries.
	-->
	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="ThingDefFishSduiggles" or defName="ThingDefSaberfish" or defName="ThingDefRedfinTuna" or defName="ThingDefFishTailteeth" or defName="ThingDefFishKillerCatfish" or defName="ThingDefDeathSturgeon"]/race</xpath>
		<value>
			<lifeStageAges Inherit="false" DeepReplace="true">
				<li>
					<def>AnimalBaby</def>
					<minAge>0</minAge>
				</li>
				<li>
					<def>AnimalJuvenile</def>
					<minAge>2</minAge>
				</li>
				<li>
					<def>AnimalAdult</def>
					<minAge>6</minAge>
					<soundWounded>Pawn_Cobra_Wounded</soundWounded>
					<soundDeath>Pawn_Cobra_Death</soundDeath>
					<soundCall>Pawn_Cobra_Call</soundCall>
					<soundAngry>Pawn_Cobra_Angry</soundAngry>
				</li>
			</lifeStageAges>
		</value>
	</Operation>

	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="ThingDefFishMashgon" or defName="ThingDefCuda" or defName="ThingDefIceFlounder" or defName="ThingDefFishSeasnake" or defName="ThingDefFishBlueblade" or defName="ThingDefFishSterlingPerch" or defName="ThingDefFishPinstripeBass"]/race</xpath>
