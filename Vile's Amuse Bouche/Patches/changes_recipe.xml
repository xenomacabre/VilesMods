	</Operation>

	<Operation Class="PatchOperationRemove">
		<xpath>Defs/RecipeDef[defName="MakeFlour"]/ingredients/li[1]/filter/thingDefs/li[text()="RawCorn"]</xpath>
	</Operation>

	<Operation Class="PatchOperationRemove">
		<xpath>Defs/RecipeDef[defName="MakeFlour"]/fixedIngredientFilter/thingDefs/li[text()="RawCorn"]</xpath>
	</Operation>
</Patch>
