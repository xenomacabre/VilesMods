<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[@Name="RangedWeaponBase"]</xpath>
    <value>
      <weaponTags Merge="True">
        <li>Neolithic</li>
      </weaponTags>
    </value>
  </Operation>

  <Operation Class="SK.PatchOperationReplaceExtended">
    <xpath>Defs/ThingDef[@Name="RangedWeaponMedievalBase"]</xpath>
    <value>
      <recipeMaker Merge="True">
        <recipeUsers>
          <li>FabricationBench</li>
          <li>CraftingSpot</li>
        </recipeUsers>
      </recipeMaker>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="MeleeWeapon_Dagger"]/weaponTags</xpath>
    <value>
      <li>LegionMelee</li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="MeleeWeapon_Gladius"]/weaponTags</xpath>
    <value>
      <li>LegionMelee</li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="MeleeWeapon_Ikwa"]/weaponTags</xpath>
    <value>
      <li>LegionMelee</li>
    </value>
  </Operation>
  <!-- <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="MeleeWeapon_Spear"]/weaponTags</xpath>
    <value>
      <li>LegionMelee</li>
    </value>
  </Operation>-->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="Pila"]/weaponTags</xpath>
    <value>
      <li>LegionRanged</li>
    </value>
  </Operation>


</Patch>