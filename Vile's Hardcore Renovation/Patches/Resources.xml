<?xml version="1.0" encoding="UTF-8"?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Core SK</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationReplace">
					<xpath>/Defs/ThingDef[@Name="StoneBlocksBase"]/stuffProps/appearance</xpath>
					<value>
						<appearance>Slab</appearance>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>/Defs/ThingDef[defName="Bamboo"]/stuffProps/appearance</xpath>
					<value>
						<appearance>Bamboo</appearance>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>/Defs/ThingDef[@Name="SoftwoodLogBase"]/stuffProps/appearance</xpath>
					<value>
						<appearance>Logs</appearance>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>/Defs/ThingDef[@Name="HardwoodLogBase"]/stuffProps/appearance</xpath>
					<value>
						<appearance>Logs</appearance>
					</value>
				</li>

				<li Class="PatchOperationReplace">
					<xpath>/Defs/ThingDef[defName="ReinforcedConcrete"]/stuffProps/appearance</xpath>
					<value>
						<appearance>Slab</appearance>
					</value>
				</li>
			</operations>
		</match>
	</Operation>


</Patch>