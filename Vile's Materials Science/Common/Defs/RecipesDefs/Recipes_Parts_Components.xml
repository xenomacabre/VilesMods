	<RecipeDef>
		<defName>MakeNanotechFramework</defName>
		<label>Assemble nanotech framework x3</label>
		<description>Create material that will be the base for nanorobotic and claytronic projects. Living cellular matter is used to "train" it with biomimetic intelligence.</description>
		<jobString>Creating nanotech framework.</jobString>
		<workAmount>3000</workAmount>
		<workSpeedStat>SmithingSpeed</workSpeedStat>
		<effectWorking>Smith</effectWorking>
		<soundWorking>Recipe_Machining</soundWorking>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Carbon</li>
					</thingDefs>
				</filter>
				<count>30</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Biomatter</li>
					</thingDefs>
				</filter>
				<count>20</count>
			</li>
		</ingredients>
		<products>
			<NanotechFramework>3</NanotechFramework>
		</products>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Carbon</li>
				<li>Biomatter</li>
			</thingDefs>
		</fixedIngredientFilter>
		<skillRequirements>
			<Crafting>16</Crafting>
		</skillRequirements>
		<workSkill>Crafting</workSkill>
		<workSkillLearnFactor>0.8</workSkillLearnFactor>
		<researchPrerequisite>Components_D2</researchPrerequisite>
	</RecipeDef>
