	<ThingDef ParentName="ResourceBase">
		<defName>Polystyrene</defName>
		<label>Polystyrene</label>
		<description>Polystyrene is a polymer made via ethylene and benzene products. It has some practical commercial applications, but out here it's more important as an ingredient in napalm. It's also used to make ABS plastic and it is the main component in synthetic rubber.</description>
		<graphicData>
			<texPath>Things/Item/Chemical/Styrene</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<color>(255,255,255)</color>
		</graphicData>
		<soundInteract>Standard_Drop</soundInteract>
		<soundDrop>Standard_Drop</soundDrop>
		<tickerType>Rare</tickerType>
		<techLevel>Industrial</techLevel>
		<statBases>
			<MarketValue>4</MarketValue>
			<DeteriorationRate>0</DeteriorationRate>
			<Flammability>5</Flammability>
			<Mass>0.07</Mass>
