	<ThingDef ParentName="ResourceBase">
		<defName>Propylene</defName>
		<label>Propylene</label>
		<description>Propylene is product of refined Crude Oil. It's a colorless, gas used for making acrylic.</description>
		<graphicData>
			<texPath>Things/Item/Chemical/Propylene</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<color>(255,255,255)</color>
		</graphicData>
		<soundInteract>Standard_Drop</soundInteract>
		<soundDrop>Standard_Drop</soundDrop>
		<tickerType>Normal</tickerType>
		<techLevel>Industrial</techLevel>
		<statBases>
			<MarketValue>1.5</MarketValue>
			<DeteriorationRate>0</DeteriorationRate>
			<Flammability>5</Flammability>
			<Mass>0.07</Mass>
			<Bulk>0.07</Bulk>
		</statBases>
		<thingCategories>
			<li>Hydrocarbons</li>
		</thingCategories>
		<stackLimit>600</stackLimit>
		<comps>
			<li Class="CompProperties_Explosive">
				<explosiveRadius>1.0</explosiveRadius>
				<explosiveDamageType>Flame</explosiveDamageType>
				<explosiveExpandPerStackcount>0.03</explosiveExpandPerStackcount>
				<startWickHitPointsPercent>0.333</startWickHitPointsPercent>
				<wickTicks>
					<min>60</min>
					<max>120</max>
				</wickTicks>
			</li>
		</comps>
	</ThingDef>
