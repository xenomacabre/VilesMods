		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="BlocksSlate"]/description</xpath>
		<value>
			<description>Recommended: Workbench/Utility construction, Tree-cutting Tools (adequate)
    
Durability: Moderate-low
Beauty: Attractive
