	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="BlocksSandstone"]/description</xpath>
		<value>
			<description>Recommended: Workbench/Utility construction, Building Tools (poor, but quick to make)
    
Durability: Moderate
