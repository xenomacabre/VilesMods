	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/RecipeDef[defName="Make_ComponentAdvanced"]</xpath>
		<value Merge="true">
			<label>Make machine fasteners</label>
			<description>Make precision machine fasteners from high-performance alloys. High-tech. Produces 10.</description>
			<jobString>Making machine fasteners.</jobString>
			<ingredients DeepReplace="true">
				<li>
					<filter>
						<categories>
							<li>SuperBar</li>
						</categories>
						<thingDefs>
							<li>AerMet</li>
						</thingDefs>
					</filter>
					<count>30</count>
				</li>
			</ingredients>
			<fixedIngredientFilter>
				<categories DeepReplace="true">
					<li>SuperBar</li>
				</categories>
				<thingDefs>
					<li>AerMet</li>
				</thingDefs>
			</fixedIngredientFilter>
		</value>
	</Operation>
