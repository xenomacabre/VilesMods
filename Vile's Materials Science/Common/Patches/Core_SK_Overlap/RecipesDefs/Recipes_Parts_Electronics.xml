<?xml version='1.0' encoding='utf-8'?>
<Patch>
	<!-- Core_SK overlap changes from Common/Defs/RecipesDefs/Recipes_Parts_Electronics.xml. Identical fields are intentionally omitted. -->
	<!-- RecipeDef: MakeSilicon_Electric -->
	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/RecipeDef[defName="MakeSilicon_Electric"]</xpath>
		<value Merge="true">
			<label>Make semiconductor material x5</label>
			<description>Doesn't quite conduct, doesn't quite not. Critical component for electronics. Typically made from silicon.</description>
			<jobString>Making semiconductor material.</jobString>
			<ingredients DeepReplace="true">
				<li>
					<filter>
						<thingDefs>
							<li>GlassBatch</li>
						</thingDefs>
					</filter>
					<count>15</count>
				</li>
			</ingredients>
			<fixedIngredientFilter>
				<thingDefs DeepReplace="true">
					<li>GlassBatch</li>
				</thingDefs>
			</fixedIngredientFilter>
			<recipeUsers>
				<li>GlassworkTable</li>
			</recipeUsers>
			<researchPrerequisite>MicroelectronicsBasics</researchPrerequisite>
		</value>
	</Operation>
	<!-- RecipeDef: MakeElectronicComponents -->
	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/RecipeDef[defName="MakeElectronicComponents"]</xpath>
		<value Merge="true">
			<label>Assemble transistors x5</label>
			<description>Transistors are an important basic component of electronics.</description>
			<jobString>Assembling transistors.</jobString>
			<ingredients DeepReplace="true">
				<li>
					<filter>
						<categories>
							<li>INSBar</li>
						</categories>
						<thingDefs>
							<li>Glass</li>
						</thingDefs>
					</filter>
					<count>10</count>
				</li>
				<li>
					<filter>
						<thingDefs>
							<li>Silicon</li>
						</thingDefs>
					</filter>
					<count>30</count>
				</li>
				<li>
					<filter>
						<thingDefs>
							<li>SilverBar</li>
							<li>AluminiumBar</li>
						</thingDefs>
					</filter>
					<count>10</count>
				</li>
				<li>
					<filter>
						<thingDefs>
							<li>Solder</li>
						</thingDefs>
					</filter>
					<count>10</count>
				</li>
			</ingredients>
			<fixedIngredientFilter>
				<thingDefs DeepReplace="true">
					<li>Silicon</li>
					<li>AluminiumBar</li>
					<li>Solder</li>
					<li>SilverBar</li>
					<li>Glass</li>
				</thingDefs>
				<categories DeepReplace="true">
					<li>INSBar</li>
				</categories>
			</fixedIngredientFilter>
		</value>
	</Operation>
