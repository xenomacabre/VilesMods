				</li>
				<li>
					<filter>
						<thingDefs>
							<li>SyntheticAmmonia</li>
						</thingDefs>
					</filter>
					<count>10</count>
				</li>
			</ingredients>
			<fixedIngredientFilter>
				<thingDefs DeepReplace="true">
					<li>Sulphates</li>
