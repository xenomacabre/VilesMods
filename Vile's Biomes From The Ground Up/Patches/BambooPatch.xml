<?xml version="1.0" encoding="UTF-8"?>
<Patch>


	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="Plant_TreeBamboo"]/graphicData</xpath>
		<value>
			<texPath>Things/Trees/BambooStalk</texPath>
			<shadowData>
				<volume>(0.15, 0.2, 0.15)</volume>
			</shadowData>
		</value>
	</Operation>
	<Operation Class="SK.PatchOperationReplaceExtended">
		<xpath>Defs/ThingDef[defName="Plant_TreeBamboo"]/plant</xpath>
		<value>
			<visualSizeRange Inherit="False">
				<min>1.0</min>
				<max>2.3</max>
			</visualSizeRange>
			<wildClusterRadius>20</wildClusterRadius>
			<wildClusterWeight>100</wildClusterWeight>
			<maxMeshCount>9</maxMeshCount>
		</value>
	</Operation>


</Patch>